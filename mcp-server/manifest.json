{
  "manifest_version": "0.2",
  "name": "caltrack",
  "version": "1.0.0",
  "description": "Track your nutrition, through the chatbots you use everyday.",
  "author": {
    "name": "ayaan"
  },
  "icon": "calTrack.png",
  "server": {
    "type": "node",
    "entry_point": "dist/index.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/dist/index.js"
      ],
      "env": {
        "SUPABASE_URL": "${user_config.supabase_url}",
        "SUPABASE_SECRET_KEY": "${user_config.supabase_secret_key}",
        "CALTRACK_USER_ID": "${user_config.caltrack_user_id}"
      }
    }
  },
  "user_config": {
    "supabase_url": {
      "type": "string",
      "title": "Supabase URL",
      "description": "The Supabase project URL, e.g. https://xxxx.supabase.co",
      "required": true
    },
    "supabase_secret_key": {
      "type": "string",
      "title": "Supabase Secret Key",
      "description": "The Supabase service role secret key",
      "required": true,
      "sensitive": true
    },
    "caltrack_user_id": {
      "type": "string",
      "title": "CalTrack User ID",
      "description": "The Supabase auth.users id this server acts on behalf of",
      "required": true
    }
  },
  "tools": [
    {
      "name": "ping"
    },
    {
      "name": "log_food_entry"
    },
    {
      "name": "get_meals_today"
    },
    {
      "name": "get_meals_by_date"
    },
    {
      "name": "get_meals_by_date_range"
    },
    {
      "name": "search_meals"
    },
    {
      "name": "update_food_entry"
    },
    {
      "name": "delete_food_entry"
    },
    {
      "name": "create_saved_meal"
    },
    {
      "name": "log_saved_meal"
    },
    {
      "name": "update_saved_meal"
    },
    {
      "name": "delete_saved_meal"
    },
    {
      "name": "search_saved_meals"
    },
    {
      "name": "list_saved_meals"
    },
    {
      "name": "set_profile"
    },
    {
      "name": "set_goals"
    },
    {
      "name": "get_goals"
    },
    {
      "name": "get_goal_progress"
    },
    {
      "name": "get_goal_history"
    },
    {
      "name": "set_calorie_override"
    },
    {
      "name": "set_macro_override"
    },
    {
      "name": "recalculate_targets"
    },
    {
      "name": "log_weight"
    },
    {
      "name": "get_weight_trends"
    },
    {
      "name": "log_water"
    },
    {
      "name": "get_water_today"
    },
    {
      "name": "get_nutrition_summary"
    },
    {
      "name": "get_trends"
    },
    {
      "name": "lookup_barcode"
    },
    {
      "name": "set_timezone"
    },
    {
      "name": "get_profile"
    }
  ],
  "license": "ISC"
}
